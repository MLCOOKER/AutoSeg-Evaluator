# Shell scripts must stay LF or they won't run on Linux/macOS.
*.sh text eol=lf

# Windows batch / VBScript stay CRLF.
*.bat text eol=crlf
*.vbs text eol=crlf

# Binary assets — never normalise line endings.
*.png binary
*.ico binary
*.icns binary
*.zip binary

# Vendored kernels are pinned by SHA-256 to the supplier's bytes, line endings
# included, and the supplier's files mix LF and CRLF. Normalising them made a
# fresh checkout fail tests/test_vendor_integrity.py on every platform.
src/autoseg_evaluator/vendor/** -text
