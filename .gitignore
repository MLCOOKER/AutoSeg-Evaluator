# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# PyInstaller
build/
dist/
*.spec.bak

# Test artefacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Runtime files (user-specific, never committed)
settings.json
*.session.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Distribution archives
*.zip
*.tar.gz

# Polygon-metric acceptance runs. The suppliers' scripts write a JSON/CSV
# record per platform; the record of a run on someone's laptop is not a repo
# artefact. CI re-runs them on every push.
third_party/native_contour_metrics/*/validation_runs/

# Compiled metric libraries built locally for a platform we do not ship a
# validated binary for. The Windows and Linux x86-64 libraries are committed,
# and pinned by hash in tests/test_vendor_integrity.py; the Linux one is
# re-included past the *.so rule above.
src/autoseg_evaluator/vendor/native_contour_metrics_fast/bin/macos-*/
!src/autoseg_evaluator/vendor/native_contour_metrics_fast/bin/linux-x86_64/libfast_native.so

# Intermediate objects from a local native-library build, and the build
# script's record of it.
src/autoseg_evaluator/vendor/build/
src/autoseg_evaluator/vendor/evidence/

# Validation runs keep their results here, to rewrite reports without recomputing
.validation_cache/
