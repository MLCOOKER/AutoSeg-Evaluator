# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# PyInstaller
build/
dist/
*.spec.bak

# Test artefacts
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Runtime files (user-specific, never committed)
settings.json
*.session.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Distribution archives
*.zip
*.tar.gz

# Polygon-metric acceptance runs. The suppliers' scripts write a JSON/CSV
# record per platform; the record of a run on someone's laptop is not a repo
# artefact. CI re-runs them on every push.
third_party/native_contour_metrics/*/validation_runs/

# Compiled metric libraries built locally or in CI for a platform we do not
# ship a validated binary for. Only the supplied Windows library is committed,
# and it is pinned by hash in tests/test_vendor_integrity.py.
src/autoseg_evaluator/vendor/native_contour_metrics_fast/bin/linux-*/
src/autoseg_evaluator/vendor/native_contour_metrics_fast/bin/macos-*/

# Intermediate objects from a local native-library build.
src/autoseg_evaluator/vendor/build/
